# ============================================
# Souk.AI - Configuration
# Copy this file to .env and fill in your values
# ============================================

# --- Database ---
POSTGRES_USER=souk_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=souk_db
DATABASE_URL=postgresql+asyncpg://souk_user:changeme_strong_password@postgres:5432/souk_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_APP_SECRET=your_app_secret

# --- OpenAI API ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- App ---
APP_ENV=production
APP_DEBUG=false
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]
