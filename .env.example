# ============================================
# Souk.AI - Configuration
# Copy this file to .env and fill in your values
# ============================================

# --- Database ---
POSTGRES_USER=souk_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=souk_db
DATABASE_URL=postgresql+asyncpg://souk_user:changeme_strong_password@postgres:5432/souk_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# REQUIRED in production (>= 32 random chars) or the API refuses to start: openssl rand -hex 32
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
# Required in production: unsigned webhook calls are rejected when APP_ENV=production
WHATSAPP_APP_SECRET=your_app_secret

# --- OpenAI API ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- App ---
APP_ENV=production
APP_DEBUG=false
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]
FRONTEND_URL=https://your-domain.com

# --- Payments (CMI) ---
# Required in production: CMI callbacks are rejected without it
CMI_STORE_KEY=

# --- Admin ---
# Read ONCE by the migration that creates merchants.is_admin. Admin rights live in the DB;
# later changes: python -m scripts.grant_admin <phone> [--revoke]
ADMIN_PHONE=212XXXXXXXXX

# --- Locale ---
# Default country for new sign-ups (MA, FR, ES, DE, US, ... see backend/core/locale.py)
DEFAULT_COUNTRY=MA

# --- Demo seed (make seed) ---
DEMO_PASSWORD=demo-souk-2026

# --- Frontend (build time) ---
# VITE_API_URL=/api/v1

# --- Cloudflare Tunnel (production only) ---
# CLOUDFLARED_TUNNEL_TOKEN=your_tunnel_token
